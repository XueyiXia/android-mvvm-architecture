<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="scaleViewModel"
            type="com.jetpack.mvvm.viewmodel.DeviceViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/dp_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_200"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="@dimen/dp_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{String.valueOf(scaleViewModel.uiState.score)}"
                        android:textColor="@color/health_green"
                        android:textSize="@dimen/sp_50"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="健康评分"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/sp_16" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="身体指标"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/sp_22"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/bg_metric_card"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_16"
                android:text="@{`体重  `+scaleViewModel.uiState.weight+` kg`}"
                android:textColor="@color/number_color"
                android:textSize="@dimen/sp_18" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/bg_metric_card"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_16"
                android:text="@{`体脂  `+scaleViewModel.uiState.fat+` %`}"
                android:textSize="@dimen/sp_18" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/bg_metric_card"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/dp_16"
                android:text="@{`肌肉  `+scaleViewModel.uiState.muscle+` kg`}"
                android:textSize="@dimen/sp_18" />

        </LinearLayout>

    </ScrollView>

</layout>